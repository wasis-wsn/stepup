# ==============================================================================
# STEPUP - Production Environment Configuration Template
# Salin file ini menjadi .env di server produksi (Dokploy Environment Variables)
# ==============================================================================

APP_NAME="STEPUP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://stepup.sorantara.id

# Domain yang didaftarkan ke Traefik / Cloudflare Tunnel
APP_DOMAIN=stepup.sorantara.id

# Port LAN/Local direct access (default: 8086 untuk menghindari bentrok dengan port 8085 milik sorantara-profile)
STEPUP_WEB_PORT=8086

# Logging
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production Database (MySQL 8.0 Container)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=stepup_db
DB_USERNAME=stepup_user
DB_PASSWORD=ChangeThisToStrongPassword123!
DB_ROOT_PASSWORD=ChangeThisToStrongRootPassword123!

# Session, Cache, Queue (Disimpan di MySQL Database untuk persistensi multi-container)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail Configuration (SMTP Production)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@stepup.id"
MAIL_FROM_NAME="${APP_NAME}"

# Swagger / OpenAPI Documentation in Production
# Ubah ke true jika ingin dokumentasi API dapat diakses publik di /api/documentation
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=https://stepup.sorantara.id
